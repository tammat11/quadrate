{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "regions": ["fra1"]
    }
  },
  "rewrites": [
    {
      "source": "/api/bootstrap",
      "destination": "/api/index?__pathname=/api/bootstrap"
    },
    {
      "source": "/api/bootstrap/sync",
      "destination": "/api/index?__pathname=/api/bootstrap/sync"
    },
    {
      "source": "/api/management-report",
      "destination": "/api/index?__pathname=/api/management-report"
    },
    {
      "source": "/api/shared-cache",
      "destination": "/api/index?__pathname=/api/shared-cache"
    },
    {
      "source": "/api/cabinet/:path*",
      "destination": "/api/index?__pathname=/api/cabinet/:path*"
    },
    {
      "source": "/api/bitrix-app-config",
      "destination": "/api/index?__pathname=/api/bitrix-app-config"
    },
    {
      "source": "/api/bitrix-app/:path*",
      "destination": "/api/index?__pathname=/api/bitrix-app/:path*"
    },
    {
      "source": "/api/bitrix/:path*",
      "destination": "/api/index?__pathname=/api/bitrix/:path*"
    },
    {
      "source": "/api/clockster/:path*",
      "destination": "/api/index?__pathname=/api/clockster/:path*"
    }
  ]
}
